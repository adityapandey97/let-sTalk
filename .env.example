# =============================================================================
# ConnectChat Environment Configuration Template
# Copy this file to .env or configure your system environment variables accordingly.
# =============================================================================

# Server Port
PORT=8080

# Database Configuration (MySQL 8.0+ Production)
# Leave commented or empty to default to the embedded persistent H2 database in MySQL mode.
DB_URL=jdbc:mysql://localhost:3306/connectchat_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8
DB_DRIVER=com.mysql.cj.jdbc.Driver
DB_USERNAME=root
DB_PASSWORD=your_secure_mysql_password

# File Upload Storage
FILE_UPLOAD_PATH=./uploads
MAX_FILE_SIZE=50MB
MAX_REQUEST_SIZE=50MB

# Application Authentication & Security
AUTH_TOKEN_EXPIRY_HOURS=72
JWT_SECRET=replace_with_a_secure_random_64_character_secret_key_in_production

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:8080

# WebRTC STUN/TURN Configuration (Optional for NAT Traversal)
STUN_SERVER_URL=stun:stun.l.google.com:19302
